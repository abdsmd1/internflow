{
  "components": {
    "schemas": {
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "thread_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent pour une nouvelle conversation.",
            "title": "Thread Id"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "pending_action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingTask"
              },
              {
                "type": "null"
              }
            ],
            "description": "Action proposée qui attend la confirmation de l'utilisateur."
          },
          "reply": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Réponse du modèle, absente si une action attend.",
            "title": "Reply"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          },
          "tools_used": {
            "description": "Outils appelés pendant ce tour (transparence).",
            "items": {
              "type": "string"
            },
            "title": "Tools Used",
            "type": "array"
          }
        },
        "required": [
          "thread_id",
          "reply",
          "tools_used",
          "pending_action"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "DecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          }
        },
        "required": [
          "approved"
        ],
        "title": "DecisionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PendingTask": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "due_date": {
            "title": "Due Date",
            "type": "string"
          },
          "internship_id": {
            "title": "Internship Id",
            "type": "string"
          },
          "internship_subject": {
            "title": "Internship Subject",
            "type": "string"
          },
          "kind": {
            "const": "create_task",
            "default": "create_task",
            "title": "Kind",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "internship_id",
          "internship_subject",
          "title",
          "due_date",
          "description"
        ],
        "title": "PendingTask",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Assistant IA qui agit via l'API InternFlow, avec validation humaine.",
    "title": "InternFlow Agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/agent/chat": {
      "post": {
        "operationId": "chat_api_v1_agent_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré (RFC 9457)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Modèle de langage indisponible (RFC 9457)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Envoyer un message à l'assistant",
        "tags": [
          "assistant"
        ]
      }
    },
    "/api/v1/agent/threads/{thread_id}/decision": {
      "post": {
        "operationId": "decide_api_v1_agent_threads__thread_id__decision_post",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Thread Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Jeton absent, invalide ou expiré (RFC 9457)"
          },
          "404": {
            "description": "Conversation introuvable"
          },
          "409": {
            "description": "Aucune action en attente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Modèle de langage indisponible (RFC 9457)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Confirmer ou refuser l'action proposée par l'assistant",
        "tags": [
          "assistant"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "santé"
        ]
      }
    }
  }
}
