# Copier ce fichier en `.env` puis adapter les valeurs.
# Le fichier `.env` est ignoré par Git : aucun secret ne doit être commité.

# --- PostgreSQL ---
POSTGRES_USER=internflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=internflow
POSTGRES_PORT=5432

# --- Service API (préfixe INTERNFLOW_ lu par pydantic-settings) ---
INTERNFLOW_ENVIRONMENT=local
INTERNFLOW_LOG_LEVEL=INFO
INTERNFLOW_DATABASE_URL=postgresql+psycopg://internflow:change-me@localhost:5432/internflow
INTERNFLOW_CORS_ORIGINS=["http://localhost:5173"]
# Secret de signature des jetons JWT : OBLIGATOIRE, 32 caractères minimum.
# Laissé vide exprès (Docker Compose refuse de démarrer tant qu'il est vide).
# Générer une valeur aléatoire avec :
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNFLOW_JWT_SECRET=
INTERNFLOW_ACCESS_TOKEN_TTL_MINUTES=30
API_PORT=8000

# --- Interface web ---
WEB_PORT=8080

# --- Assistant IA (docker compose --profile ai up -d) ---
# Modèle Ollama : qwen2.5:3b (~2 Go, adapté à un portable) ou qwen2.5:7b (~5 Go,
# meilleur, mais demande ~8 Go de mémoire libre pour Docker ou une carte graphique).
INTERNFLOW_AGENT_LLM_MODEL=qwen2.5:3b

# --- Pipeline de données (préfixe INTERNFLOW_DATA_) ---
# Sel de pseudonymisation : OBLIGATOIRE, 16 caractères minimum, à garder secret.
# Le changer rend les nouvelles clés impossibles à relier aux anciennes.
# Générer une valeur aléatoire avec :
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNFLOW_DATA_PSEUDONYMIZATION_SALT=
INTERNFLOW_DATA_SPARK_MASTER=local[*]
